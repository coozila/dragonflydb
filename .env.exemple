#   DRAGONFLYDB CLUSTER CONFIGURATION                                                #

#   NETWORK SETTINGS    ------------------------------------------------------------#

# Local address for the application
LOCAL_LISTEN_ADDR=127.0.0.1

#   DRAGONFLYDB SERVERS    ---------------------------------------------------------#

# Default hostname for DragonflyDB instances
# DRAGONFLYDB_HOSTNAME=localhost

# Hostnames for individual DragonflyDB instances
DRAGONFLYDB1_HOSTNAME=ldragonfly1
DRAGONFLYDB2_HOSTNAME=ldragonfly2
DRAGONFLYDB3_HOSTNAME=ldragonfly3
DRAGONFLYDB4_HOSTNAME=ldragonfly4
DRAGONFLYDB5_HOSTNAME=ldragonfly5

# Memory lock limits for DragonflyDB instances 
MEMLOCK=-1  # Use -1 for auto-adjustment

#   MCROUTER SERVER    -------------------------------------------------------------#

#   MCROUTER VERSION
MCROUTER_VERSION=40.0.0

# MCROUTER HOSTNAME
MCROUTER_HOSTNAME=localhost

# Hostnames for mcrouter instances
MCROUTER1_HOSTNAME=mcrouter1
MCROUTER2_HOSTNAME=mcrouter2
MCROUTER3_HOSTNAME=mcrouter3

# Optional custom network configurations
STACK_PRIVATE_NETWORK=stack_private_network
MCROUTER_PRIVATE_NETWORK=mcrouter_private_network
MEMCACHED_PRIVATE_NETWORK=memcached_private_network

#   VOLUMES    ---------------------------------------------------------------------#

# Volume names for DragonflyDB data persistence
DRAGONFLYDATA1=dragonflydata1
DRAGONFLYDATA2=dragonflydata2
DRAGONFLYDATA3=dragonflydata3
DRAGONFLYDATA4=dragonflydata4
DRAGONFLYDATA5=dragonflydata5

# ----------------------------------------------------------------------------------#
