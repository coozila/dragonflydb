#   DRAGONFLYDB CLUSTER CONFIGURATION                                               #

#   NETWORK SETTINGS    ------------------------------------------------------------#

#   Local address for the application
LOCAL_LISTEN_ADDR=127.0.0.1


#   DRAGONFLYDB SERVERS    ---------------------------------------------------------#

#   Memory lock limits for DragonflyDB instances 
#   Use -1 for auto-adjustment
# DRAGONFLYDB_MEMLOCK=-1 

#   Default hostname for DragonflyDB instances
# DRAGONFLYDB_HOSTNAME=localhost

# DragonflyDB Master Hostnames
DRAGONFLYDB_MASTER1_HOSTNAME=dragonfly_master1
DRAGONFLYDB_MASTER2_HOSTNAME=dragonfly_master2
DRAGONFLYDB_MASTER3_HOSTNAME=dragonfly_master3

# DragonflyDB Slave Hostnames
DRAGONFLYDB_SLAVE1_HOSTNAME=dragonfly_slave1
DRAGONFLYDB_SLAVE2_HOSTNAME=dragonfly_slave2
DRAGONFLYDB_SLAVE3_HOSTNAME=dragonfly_slave3


# ----------------------------------------------------------------------------------#

#   MCROUTER SERVER    -------------------------------------------------------------#

#   MCROUTER VERSION
MCROUTER_VERSION=40.0.0

#   MCROUTER HOSTNAME
MCROUTER_HOSTNAME=localhost

#   Hostnames for mcrouter instances
MCROUTER1_HOSTNAME=mcrouter1
MCROUTER2_HOSTNAME=mcrouter2
MCROUTER3_HOSTNAME=mcrouter3


# ----------------------------------------------------------------------------------#

#   CLUSTER POOL VARIANT FOR 3 MATER + 3 SLAVE DRAGONFLYDB   -----------------------#

#   1. Single-Pool Variant:
#   A simple configuration with less logical separation.
#   Exemple: MCROUTER_POOL_VARIANT=1pool
# MCROUTER_POOL_VARIANT=1pool

#   2. Two-Pool Variant:
#   Redundancy and balanced utilization between master and slave, optimal for moderate scalability.
#   Exemple: MCROUTER_POOL_VARIANT=1pool
# MCROUTER_POOL_VARIANT=1pool

#   3. Three-Pool Variant:
#   Maximum performance, scalability, and localized redundancy.
#   Exemple: MCROUTER_POOL_VARIANT=3pool
# MCROUTER_POOL_VARIANT=3pool

#   4. Failover Pool:
#   Ensures high availability by failing over requests to alternative pools in case of server failure.
#   Exemple: MCROUTER_POOL_VARIANT=failover_pool
# MCROUTER_POOL_VARIANT=failover_pool

#   5. Load Balancer Pool:
#   Distributes requests based on server load for optimized performance.
#   Exemple: MCROUTER_POOL_VARIANT=loadbalancer_pool
# MCROUTER_POOL_VARIANT=loadbalancer_pool

#   6. Shard Pool:
#   Routes requests to shards based on key segmentation for distributed caching.
#   Exemple: MCROUTER_POOL_VARIANT=shard_pool
# MCROUTER_POOL_VARIANT=shard_pool

#   7. Weighted Pool:
#   Assigns weights to servers for uneven distribution based on server capacity.
#   Exemple: MCROUTER_POOL_VARIANT=weighted_pool
# MCROUTER_POOL_VARIANT=weighted_pool

#   8. Custom Hash Pool:
#   Routes requests using a specific hash function for specialized workloads.
#   Exemple: MCROUTER_POOL_VARIANT=custom_hash_pool
# MCROUTER_POOL_VARIANT=custom_hash_pool

#   10. Load Balancer Pool With Failover:
#   Combines two load balancing pools for better performance and redundancy, while incorporating a failover pool for high availability in case one of the master pools becomes unavailable.
#   Exemple: MCROUTER_POOL_VARIANT=2LoadBalancerPooll+1FailoverPool
MCROUTER_POOL_VARIANT=2LoadBalancerPooll+1FailoverPool

#   11. Load Balancer Pool With Failover and Shard:
#   Utilizes two load balancing pools and a failover pool, with sharding for distributed caching. This configuration enhances scalability and performance by distributing data across multiple shards, ensuring efficient resource utilization and fault tolerance.
#   Exemple: MCROUTER_POOL_VARIANT=2LoadBalancerPooll+1FailoverPool+Shard
# MCROUTER_POOL_VARIANT=2LoadBalancerPooll+1FailoverPool+Shard


# ----------------------------------------------------------------------------------#

#   DATA STORAGE MASTER & SLAVE   ---------------------------------------------------#

# Environment Variables for DragonflyDB Data Storage Cluster Configuration for master slave

# DRAGONFLYDB_MASTER1_DATA
# This variable defines the data storage path for the DragonflyDB master instance 1.
#DRAGONFLYDB_MASTER1_DATA=/path/to/your/dragonfly_master1_data

# DRAGONFLYDB_MASTER2_DATA
# This variable defines the data storage path for the DragonflyDB master instance 2.
#DRAGONFLYDB_MASTER2_DATA=/path/to/your/dragonfly_master2_data

# DRAGONFLYDB_MASTER3_DATA
# This variable defines the data storage path for the DragonflyDB master instance 3.
#DRAGONFLYDB_MASTER3_DATA=/path/to/your/dragonfly_master3_data

# DRAGONFLYDB_SLAVE1_DATA
# This variable defines the data storage path for the DragonflyDB slave instance 1.
#DRAGONFLYDB_SLAVE1_DATA=/path/to/your/dragonfly_slave1_data

# DRAGONFLYDB_SLAVE2_DATA
# This variable defines the data storage path for the DragonflyDB slave instance 2.
#DRAGONFLYDB_SLAVE2_DATA=/path/to/your/dragonfly_slave2_data

# DRAGONFLYDB_SLAVE3_DATA
# This variable defines the data storage path for the DragonflyDB slave instance 3.
#DRAGONFLYDB_SLAVE3_DATA=/path/to/your/dragonfly_slave3_data


# ----------------------------------------------------------------------------------#

#   SNAPSHOT_CRON    -----------------------------------------------------------------#

# Environment Variables for DragonflyDB Cluster Configuration

#   SNAPSHOT_CRON
#   This variable defines the cron schedule for taking snapshots of the DragonflyDB instances.
#   The default value is set to "*/5 * * * *", which means that snapshots will be taken every 5 minutes.
#   You can modify this variable to set a different schedule according to your requirements.
#   The format follows standard cron syntax:
#   ┌───────────── minute (0 - 59)
#   │ ┌───────────── hour (0 - 23)
#   │ │ ┌───────────── day of the month (1 - 31)
#   │ │ │ ┌───────────── month (1 - 12)
#   │ │ │ ┌───────────── day of the week (0 - 6) (Sunday to Saturday)
#   │ │ │ │
#   * * * * *
#
#   Examples:
#
#   Take a snapshot every hour at minute 0
#SNAPSHOT_CRON="0 * * * *"

#   Take a snapshot every day at midnight
#SNAPSHOT_CRON="0 0 * * *"

#   Take a snapshot every 10 minutes
#SNAPSHOT_CRON="*/10 * * * *"

#   Default: Take a snapshot every 5 minutes
SNAPSHOT_CRON="*/5 * * * *"  

#   Default: Take a snapshot every 1 minutes
# SNAPSHOT_CRON="*/1 * * * *"  