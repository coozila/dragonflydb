#DRAGONFLYDB1_DATA=/path/to/your/dragonflydata1

#   DRAGONFLYDB_INSTANCE 2 DATA
#   This variable defines the data storage path for the DragonflyDB instance 2.
#DRAGONFLYDB2_DATA=/path/to/your/dragonflydata2

#   DRAGONFLYDB INSTANCE 3 DATA
#   This variable defines the data storage path for the DragonflyDB instance 3.
#DRAGONFLYDB3_DATA=/path/to/your/dragonflydata3

#   DRAGONFLYDB INSTANCE 4_DATA
#   This variable defines the data storage path for the DragonflyDB instance 4.
#DRAGONFLYDB4_DATA=/path/to/your/dragonflydata4

#   DRAGONFLYDB INSTANCE 5 DATA
#   This variable defines the data storage path for the DragonflyDB instance 5.
#DRAGONFLYDB5_DATA=/path/to/your/dragonflydata5


